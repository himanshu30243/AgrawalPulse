# Not needed manually - `npm run dev:mock` sets VITE_USE_MOCK_DATA=true itself. This file just
# documents what that flag does: main.tsx starts an MSW service worker (src/mocks/browser.ts)
# that intercepts every /api/v1/* call and answers with the same fixtures/handlers the component
# tests use (src/mocks/handlers.ts) - the whole GUI runs with zero backend services running.
VITE_USE_MOCK_DATA=true
VITE_API_BASE_URL=/api/v1
