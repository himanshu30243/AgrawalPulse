meta {
  name: Get Dev Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/local-auth/token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "chapterId": "{{chapterId}}",
    "email": "tester@example.com",
    "roles": ["CHAPTER_ADMIN", "MATRIMONY_VIEWER"]
  }
}

script:post-response {
  if (res.body.accessToken) {
    bru.setVar("accessToken", res.body.accessToken);
  }
}

docs {
  local profile only - stands in for Cognito. Run this first; every other request in this
  collection reads the Authorization header from {{accessToken}}, set here.
}
