# ========== Frontend (Node.js / Vite / React) ==========
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env.local
frontend/.env.*.local
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.DS_Store
# TypeScript's own incremental build cache - regenerates on every `tsc` run (including CI's
# npm run build), was tracked in git by mistake so it showed as "modified" after every local
# build regardless of any real change.
frontend/*.tsbuildinfo

