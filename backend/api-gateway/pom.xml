<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agrawalpulse</groupId>
        <artifactId>agrawalpulse-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>api-gateway</artifactId>
    <name>agrawalpulse-api-gateway</name>
    <description>API Gateway - Single entry point for all client requests. Routes to user-service,
        family-service, membership-service, matrimony-service, event-service, analytics-service.
        Handles JWT auth, rate limiting, CORS, circuit breaker at gateway level.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Spring Cloud Gateway is reactive (Netty/WebFlux) and is incompatible on the same
             classpath as Spring MVC (servlet). common pulls in spring-boot-starter-web,
             spring-boot-starter-security, oauth2-resource-server and springdoc's webmvc-ui for
             every other (servlet-based) service, so all of those must be excluded here - the
             gateway only needs common's logging/resilience/cache pieces. -->
        <dependency>
            <groupId>com.agrawalpulse</groupId>
            <artifactId>common</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-security</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Spring Cloud Gateway: Non-blocking gateway for routing & filtering.
             Versions for all spring-cloud-* artifacts below come from the spring-cloud-dependencies
             BOM (backend/pom.xml) - do not pin them individually here, that reintroduces the
             version-skew ClassNotFoundException this project hit before the BOM was added. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- Gateway discovery: Dynamic service lookup (load-balanced lb:// routes) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- Rate limiting: Token bucket algorithm -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Gateway actuator: /actuator/gatewayroutes to view all routes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
