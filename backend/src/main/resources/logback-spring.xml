<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property name="LOG_HOME" value="logs" />
  <property name="LOG_FILE_MAX_SIZE" value="10MB" />
  <property name="LOG_FILE_MAX_HISTORY" value="7" />
  <property name="LOG_PATTERN" value="%d{ISO8601} [%thread] %-5level %logger{36} - %msg%n" />

  <!-- Console appender for development -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- JSON file appender for ELK (Elasticsearch/Logstash) -->
  <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/${spring.application.name}-json.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/${spring.application.name}-json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
      <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"${spring.application.name}","environment":"${spring.profiles.active}"}</customFields>
      <includeContext>true</includeContext>
      <includeMdcKeyName>true</includeMdcKeyName>
      <mdc>
        <fieldName>mdc</fieldName>
      </mdc>
    </encoder>
  </appender>

  <!-- Plain text file appender for human debugging -->
  <appender name="FILE_TEXT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/${spring.application.name}-text.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/${spring.application.name}-text.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
      <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{ISO8601} [%X{traceId},%X{spanId},%X{correlationId}] %-5level %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Reduce noise from Spring and Hibernate -->
  <logger name="org.springframework" level="INFO" />
  <logger name="org.springframework.web" level="INFO" />
  <logger name="org.springframework.security" level="INFO" />
  <logger name="org.hibernate" level="INFO" />
  <logger name="org.flywaydb" level="INFO" />
  <logger name="com.agrawalpulse" level="DEBUG" />

  <!-- Local development profile: console + JSON + text -->
  <springProfile name="local">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE" />
      <appender-ref ref="FILE_JSON" />
      <appender-ref ref="FILE_TEXT" />
    </root>
  </springProfile>

  <!-- Development profile: console + JSON -->
  <springProfile name="dev">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE" />
      <appender-ref ref="FILE_JSON" />
    </root>
  </springProfile>

  <!-- Staging profile: JSON only -->
  <springProfile name="staging">
    <root level="INFO">
      <appender-ref ref="FILE_JSON" />
    </root>
  </springProfile>

  <!-- Production profile: JSON only, INFO level -->
  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="FILE_JSON" />
    </root>
  </springProfile>

</configuration>
